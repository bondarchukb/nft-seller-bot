# ── Blockchain / RPC ──────────────────────────────────────────────────
# Ethereum Sepolia testnet (e.g. Alchemy / Infura URL)
RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Polygon Amoy testnet
POLYGON_RPC_URL=https://rpc-amoy.polygon.technology

# ── Wallet ────────────────────────────────────────────────────────────
# Private key of the deployer / bot wallet (no 0x prefix needed)
PRIVATE_KEY=your_private_key_here

# ── Block explorer API keys (for contract verification) ───────────────
ETHERSCAN_API_KEY=your_etherscan_api_key
POLYGONSCAN_API_KEY=your_polygonscan_api_key

# ── Deployed contract address (filled after deploy) ───────────────────
NFT_CONTRACT_ADDRESS=

# ── Bot settings ──────────────────────────────────────────────────────
# "simulation" | "local" | "sepolia" | "polygon_amoy"
BOT_MODE=simulation

# IPFS / metadata base URI (used when minting on-chain)
METADATA_BASE_URI=https://ipfs.io/ipfs/
